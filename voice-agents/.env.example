# ngrok ya apne domain ka host (https:// ke bina), e.g. abcd-1234.ngrok-free.app
PUBLIC_DOMAIN=

# Twilio (twilio.com/console se)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Groq (console.groq.com se, free)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# faster-whisper model size: tiny / base / small / medium
WHISPER_MODEL=small

# Piper Hindi voice files (piper-voices repo se download karke voices/ me rakho)
PIPER_MODEL_PATH=voices/hi_IN.onnx
PIPER_CONFIG_PATH=voices/hi_IN.onnx.json
